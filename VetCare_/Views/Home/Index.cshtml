@{
    ViewData["Title"] = "Anasayfa";
}

<!-- GİRİŞ -->
<div class="welcome-section">
    <div>
        <h2>Hoş Geldiniz! 🐾</h2>
        <p>VetCare hoş geldiniz. Kliniğinizin genel durumunu buradan takip edebilirsiniz.</p>
    </div>

    <div class="welcome-icon">
        🐶 🐱
    </div>
</div>

<!-- İSTATİSTİK  -->
<div class="stats-grid">

    <div class="stat-card">
        <div class="stat-icon purple-icon">👥</div>
        <div>
            <p>Toplam Hayvan Sahibi</p>
            <h3>0</h3>
            <small>Kayıtlı sahip</small>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon turquoise-icon">🐾</div>
        <div>
            <p>Kayıtlı Hayvan</p>
            <h3>0</h3>
            <small>Toplam hasta</small>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon blue-icon">📅</div>
        <div>
            <p>Bugünkü Randevular</p>
            <h3>0</h3>
            <small>Planlanan randevu</small>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon pink-icon">💉</div>
        <div>
            <p>Yaklaşan Aşılar</p>
            <h3>0</h3>
            <small>Takip edilmesi gereken</small>
        </div>
    </div>

</div>

<!-- ALT BÖLÜM -->
<div class="dashboard-grid">

    <div class="dashboard-card">
        <div class="card-heading">
            <h4>Son Randevular</h4>
            <span>Son işlemler</span>
        </div>

        <div class="table-responsive">
            <table class="table dashboard-table">
                <thead>
                    <tr>
                        <th>Hayvan</th>
                        <th>Sahibi</th>
                        <th>İşlem</th>
                        <th>Durum</th>
                    </tr>
                </thead>

                <tbody>
                <!--Sonra düzenle-->>
                </tbody>
            </table>
        </div>
    </div>

    <div class="dashboard-card vaccine-card">
        <div class="card-heading">
            <h4>Aşı Hatırlatmaları</h4>
        </div>

        <div class="vaccine-item">
            <span class="vaccine-icon">💉</span>
   
        </div>

        <div class="vaccine-item">
            <span class="vaccine-icon">💉</span>
            </div>

        <div class="vaccine-item">
            <span class="vaccine-icon">💉</span>
     
        </div>
    </div>

</div>
