@model IEnumerable<VetCare.Models.Muayene>

@{
    ViewData["Title"] = "Muayene Kayıtları";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Muayene Kayıtları</h2>
            <p class="text-muted">Hayvanların muayene geçmişini buradan takip edebilirsiniz.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Yeni Muayene Ekle
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Hayvan Adı</th>
                            <th>Hayvan Sahibi</th>
                            <th>Muayene Tarihi</th>
                            <th>Muayene Saati</th>
                            <th>Yapılan İşlem</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var muayene in Model)
                            {
                                <tr>
                                    <td>@(muayene.Pet?.Name ?? "Hayvan bulunamadı")</td>
                                    <td>@(muayene.Pet?.Owner?.FullName ?? "Sahip bulunamadı")</td>
                                    <td>@muayene.MuayeneTarihi.ToString("dd.MM.yyyy")</td>
                                    <td>@muayene.MuayeneSaati.ToString(@"hh\:mm")</td>
                                    <td>@muayene.YapilanIslem</td>
                                    <td>
                                        <a asp-action="Edit"
                                           asp-route-id="@muayene.Id"
                                           class="btn btn-sm btn-warning">
                                            Düzenle
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@muayene.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Bu muayene kaydını silmek istediğinize emin misiniz?');">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                Sil
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    Henüz muayene kaydı bulunmuyor.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
